<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>BLOG</h2>
            <a href="/admin/blog_list" class="header-action-btn" title="View List">−</a>
        </div>

        <div class="card">

            <div class="card-header">
                <h5 class="mb-0">Update Blog</h5>
            </div>

            <div class="card-body">

                <form action="/admin/blog_update_save" method="POST" enctype="multipart/form-data">

                    <input type="hidden" name="bid" value="<%= blog.bid %>">

                    <div class="row g-3">

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Blog Date</label>
                            <input
                                type="date"
                                name="bdate"
                                value="<%= blog.bdate %>"
                                class="form-control"
                                required>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Blog Title</label>
                            <input
                                type="text"
                                name="btitle"
                                value="<%= blog.btitle %>"
                                class="form-control"
                                placeholder="Enter Blog Title"
                                required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Blog Content</label>
                            <textarea
                                name="bcontent"
                                rows="5"
                                class="form-control"
                                required><%= blog.bcontent %></textarea>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Blog Image</label>
                            <input type="file" name="bimg" class="form-control">
                            <input type="hidden" name="old_img" value="<%= blog.bimg %>">
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Current Image</label>
                            <div>
                                <img src="/<%= blog.bimg %>" width="150" class="img-thumbnail">
                            </div>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Update Blog
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

<%- include('footer') %>

