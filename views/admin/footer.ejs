    <script>
        let isNavigatingInside = false;

        document.querySelectorAll('a, form, button').forEach(el => {
            el.addEventListener('click', () => { isNavigatingInside = true; });
            if (el.tagName.toLowerCase() === 'form') {
                el.addEventListener('submit', () => { isNavigatingInside = true; });
            }
        });

        window.addEventListener('beforeunload', function (e) {
            if (!isNavigatingInside) {
                e.preventDefault();
                e.returnValue = 'Please logout before leaving this page.';
            }
        });
    </script>
