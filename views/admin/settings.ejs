<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>SETTINGS</h2>
        </div>

        <div class="card">
            <div class="card-body">

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-4" role="tablist">

                    <li class="nav-item">
                        <button class="nav-link active"
                                data-bs-toggle="tab"
                                data-bs-target="#general"
                                type="button">
                            <i class="fas fa-cog me-2"></i>General
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link"
                                data-bs-toggle="tab"
                                data-bs-target="#social"
                                type="button">
                            <i class="fas fa-share-alt me-2"></i>Social Media
                        </button>
                    </li>

                </ul>

                <div class="tab-content">

                    <!-- ================= GENERAL ================= -->

                   <div class="tab-pane fade show active" id="general">

                    <form action="/admin/contact_save"
                        method="POST"
                        enctype="multipart/form-data">

                        <div class="row g-4">

                            <!-- Left Side -->
                            <div class="col-lg-8">

                                <div class="row g-3">

                                    <div class="col-lg-6">
                                        <label class="form-label">Email</label>
                                        <input type="email"
                                            name="email"
                                            class="form-control"
                                            value="<%= contact[0].email %>">
                                    </div>

                                    <div class="col-lg-6">
                                        <label class="form-label">Phone</label>
                                        <input type="tel"
                                            name="phone"
                                            class="form-control"
                                            value="<%= contact[0].phone %>">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Address</label>
                                        <textarea
                                            name="address"
                                            rows="3"
                                            class="form-control"><%= contact[0].address %></textarea>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Google Map</label>
                                        <input type="url"
                                            name="map"
                                            class="form-control"
                                            value="<%= contact[0].map %>">
                                    </div>

                                </div>

                            </div>

                            <!-- Right Side -->
                            <div class="col-lg-4">

                                <label class="form-label">Current Logo</label>

                                <div class="border rounded text-center p-2 mb-3">
                                    <img src="/<%= contact[0].logo %>"
                                        class="img-fluid rounded"
                                        style="max-height:120px;">
                                </div>

                                <label class="form-label">Upload New Logo</label>

                                <input type="file"
                                    name="logo"
                                    class="form-control mb-3">

                                <input type="hidden"
                                    name="old_logo"
                                    value="<%= contact[0].logo %>">

                                <button class="btn btn-primary w-100">
                                    Save Settings
                                </button>

                            </div>

                        </div>

                    </form>

                </div>
                    <!-- ================= SOCIAL ================= -->

                    <div class="tab-pane fade" id="social">

                        <form action="/admin/social_save" method="POST">

                            <div class="row g-3">

                                <div class="col-lg-6">
                                    <label class="form-label">
                                        <i class="fab fa-facebook text-primary me-2"></i>Facebook
                                    </label>
                                    <input type="url"
                                           name="facebook"
                                           class="form-control"
                                           value="<%= social_media[0].facebook %>">
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label">
                                        <i class="fab fa-twitter text-info me-2"></i>Twitter
                                    </label>
                                    <input type="url"
                                           name="twitter"
                                           class="form-control"
                                           value="<%= social_media[0].twitter %>">
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label">
                                        <i class="fab fa-instagram text-danger me-2"></i>Instagram
                                    </label>
                                    <input type="url"
                                           name="instagram"
                                           class="form-control"
                                           value="<%= social_media[0].instagram %>">
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label">
                                        <i class="fab fa-linkedin text-primary me-2"></i>LinkedIn
                                    </label>
                                    <input type="url"
                                           name="linkedin"
                                           class="form-control"
                                           value="<%= social_media[0].linkedin %>">
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label">
                                        <i class="fab fa-github me-2"></i>GitHub
                                    </label>
                                    <input type="url"
                                           name="github"
                                           class="form-control"
                                           value="<%= social_media[0].github %>">
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label">
                                        <i class="fab fa-youtube text-danger me-2"></i>YouTube
                                    </label>
                                    <input type="url"
                                           name="youtube"
                                           class="form-control"
                                           value="<%= social_media[0].youtube %>">
                                </div>

                            </div>

                            <div class="mt-4">
                                <button class="btn btn-primary">
                                    Save Settings
                                </button>
                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

<%- include('footer') %>