<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>EXPERIENCE</h2>
            <a href="/admin/experience_add" class="header-action-btn" title="Add New">+</a>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th width="80">#</th>
                                <th>Experience Duration</th>
                                <th width="180">Position</th>
                                <th width="180">Company</th>
                                <th width="200">Description</th>
                                <th width="160" class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if(experience.length > 0){ %>

                                <% for(let i = 0; i < experience.length; i++){ %>
                                    <tr>
                                        <td><%= i + 1 %></td>

                                        <td>
                                            <strong><%= experience[i].exp_duration %></strong>
                                        </td>

                                        <td>
                                            <%= experience[i].exp_position %>
                                        </td>

                                        <td>
                                            <%= experience[i].exp_company %>
                                        </td>

                                        <td>
                                            <%= experience[i].exp_desc %>
                                        </td>

                                        <td class="text-center">

                                            <a href="/admin/edit_experience/<%= experience[i].eid %>"
                                                class="btn btn-warning btn-sm me-1"
                                                title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a href="/admin/delete_experience/<%= experience[i].eid %>"
                                                class="btn btn-danger btn-sm"
                                                title="Delete"
                                                onclick="return confirm('Are you sure you want to delete this experience?')">
                                                <i class="fas fa-trash"></i>
                                            </a>

                                        </td>
                                    </tr>
                                <% } %>

                            <% } else { %>

                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        No experience found.
                                    </td>
                                </tr>

                            <% } %>
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

