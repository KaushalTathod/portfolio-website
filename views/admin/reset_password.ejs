<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Reset Password · SKILLER Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #101322;
    font-family: 'Inter', sans-serif;
    color: #e6e8f0;
    padding: 20px;
  }
  .card {
    width: 100%;
    max-width: 380px;
    background: #171a2b;
    border: 1px solid #2a2e40;
    border-radius: 10px;
    padding: 32px 28px;
  }
  .card h1 {
    font-size: 20px;
    text-align: center;
    margin: 0 0 4px;
  }
  .card h1 span { color: #5eead4; }
  .card p {
    text-align: center;
    color: #767c94;
    font-size: 13px;
    margin: 0 0 24px;
  }
  label {
    display: block;
    font-size: 13px;
    color: #a0a4b8;
    margin-bottom: 6px;
  }
  .field { margin-bottom: 18px; }
  input[type="password"] {
    width: 100%;
    background: #0f1120;
    border: 1px solid #2a2e40;
    border-radius: 6px;
    padding: 10px 12px;
    color: #e6e8f0;
    font-size: 14px;
    outline: none;
  }
  input:focus { border-color: #5eead4; }
  button {
    width: 100%;
    background: #5eead4;
    color: #0a1f1c;
    border: none;
    border-radius: 6px;
    padding: 11px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover { filter: brightness(1.08); }
  .error {
    background: rgba(248,113,113,0.1);
    border-left: 3px solid #f87171;
    color: #fca5a5;
    font-size: 12.5px;
    padding: 8px 10px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .hidden { display: none; }
</style>
</head>
<body>

  <div class="card">
    <h1>New <span>Password</span></h1>
    <p>Enter your new password below</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div id="mismatchAlert" class="error hidden">Passwords do not match</div>

    <form id="resetForm" action="/admin/reset_password" method="POST">
      <div class="field">
        <label for="new_password">New Password</label>
        <input type="password" name="new_password" id="new_password" placeholder="New password" required minlength="4" />
      </div>
      <div class="field">
        <label for="confirm_password">Confirm Password</label>
        <input type="password" name="confirm_password" id="confirm_password" placeholder="Confirm password" required minlength="4" />
      </div>

      <button type="submit">Reset Password</button>
    </form>
  </div>

<script>
  document.getElementById('resetForm').onsubmit = (e) => {
    const p1 = document.getElementById('new_password').value;
    const p2 = document.getElementById('confirm_password').value;
    const alertBox = document.getElementById('mismatchAlert');
    if (p1 !== p2) {
      e.preventDefault();
      alertBox.classList.remove('hidden');
    } else {
      alertBox.classList.add('hidden');
    }
  };
</script>
</body>
</html>