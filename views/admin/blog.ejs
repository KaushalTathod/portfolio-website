<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>BLOG</h2>
            <a href="/admin/blog_list" class="header-action-btn" title="View List">−</a>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Add Blog</h5>
            </div>

            <div class="card-body">

                <form action="/admin/blog_add_save" method="POST" enctype="multipart/form-data">

                    <div class="row g-3">

                        <div class="col-lg-6">
                            <label class="form-label">Blog Date</label>
                            <input type="date" name="bdate" class="form-control" required>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Blog Title</label>
                            <input type="text" name="btitle" class="form-control" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Blog Content</label>
                            <textarea name="bcontent" rows="5" class="form-control" required></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Blog Image</label>
                            <input type="file" name="bimg" class="form-control" required>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Blog
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

