<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Forgot Password · SKILLER Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #101322;
    font-family: 'Inter', sans-serif;
    color: #e6e8f0;
    padding: 20px;
  }
  .card {
    width: 100%;
    max-width: 380px;
    background: #171a2b;
    border: 1px solid #2a2e40;
    border-radius: 10px;
    padding: 32px 28px;
  }
  .card h1 {
    font-size: 20px;
    text-align: center;
    margin: 0 0 4px;
  }
  .card h1 span { color: #5eead4; }
  .card p {
    text-align: center;
    color: #767c94;
    font-size: 13px;
    margin: 0 0 24px;
  }
  label {
    display: block;
    font-size: 13px;
    color: #a0a4b8;
    margin-bottom: 6px;
  }
  .field { margin-bottom: 18px; }
  input[type="email"] {
    width: 100%;
    background: #0f1120;
    border: 1px solid #2a2e40;
    border-radius: 6px;
    padding: 10px 12px;
    color: #e6e8f0;
    font-size: 14px;
    outline: none;
  }
  input:focus { border-color: #5eead4; }
  button {
    width: 100%;
    background: #5eead4;
    color: #0a1f1c;
    border: none;
    border-radius: 6px;
    padding: 11px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover { filter: brightness(1.08); }
  .info {
    background: rgba(94,234,212,0.08);
    border-left: 3px solid #5eead4;
    color: #cdeee7;
    font-size: 12.5px;
    padding: 8px 10px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .error {
    background: rgba(248,113,113,0.1);
    border-left: 3px solid #f87171;
    color: #fca5a5;
    font-size: 12.5px;
    padding: 8px 10px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .back-link {
    display: block;
    text-align: center;
    margin-top: 20px;
    color: #767c94;
    text-decoration: none;
    font-size: 13px;
  }
  .back-link:hover { color: #5eead4; }
</style>
</head>
<body>

  <div class="card">
    <h1>Reset <span>Password</span></h1>
    <p>Enter your email to receive a reset link</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div class="info">
      We'll send a reset link to your registered email address.
    </div>

    <form action="/admin/forget" method="POST">
      <div class="field">
        <label for="email">Email Address</label>
        <input type="email" name="email" id="email" placeholder="you@domain.com" required />
      </div>

      <button type="submit">Send Reset Link</button>
    </form>

    <a href="/admin/login" class="back-link">&larr; Back to Login</a>
  </div>

</body>
</html>