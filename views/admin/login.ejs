<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Login · SKILLER Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #101322;
    font-family: 'Inter', sans-serif;
    color: #e6e8f0;
    padding: 20px;
  }
  .card {
    width: 100%;
    max-width: 380px;
    background: #171a2b;
    border: 1px solid #2a2e40;
    border-radius: 10px;
    padding: 32px 28px;
  }
  .card h1 {
    font-size: 20px;
    text-align: center;
    margin: 0 0 4px;
  }
  .card h1 span { color: #5eead4; }
  .card p {
    text-align: center;
    color: #767c94;
    font-size: 13px;
    margin: 0 0 24px;
  }
  label {
    display: block;
    font-size: 13px;
    color: #a0a4b8;
    margin-bottom: 6px;
  }
  .field { margin-bottom: 16px; position: relative; }
  input[type="text"], input[type="password"] {
    width: 100%;
    background: #0f1120;
    border: 1px solid #2a2e40;
    border-radius: 6px;
    padding: 10px 12px;
    color: #e6e8f0;
    font-size: 14px;
    outline: none;
  }
  input:focus { border-color: #5eead4; }
  .toggle-pass {
    position: absolute;
    right: 10px;
    top: 34px;
    background: none;
    border: none;
    color: #767c94;
    cursor: pointer;
    font-size: 12px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
    margin-bottom: 18px;
    color: #a0a4b8;
  }
  .row a { color: #f472b6; text-decoration: none; }
  button {
    width: 100%;
    background: #5eead4;
    color: #0a1f1c;
    border: none;
    border-radius: 6px;
    padding: 11px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover { filter: brightness(1.08); }
  .alert {
    background: rgba(248,113,113,0.1);
    border-left: 3px solid #f87171;
    color: #fca5a5;
    font-size: 12.5px;
    padding: 8px 10px;
    border-radius: 4px;
    margin-bottom: 14px;
  }
  .hidden { display: none; }
</style>
</head>
<body>

  <div class="card">
    <h1>SKILLER<span>Admin</span></h1>
    <p>Suggesion : Lession Boney M.-Rasputin</p>

    <form id="loginForm" action="/admin/check_login" method="post" novalidate>

      <div id="loginAlert" class="alert hidden">
        <span id="alertMessage">Invalid username or password</span>
      </div>

      <div class="field">
        <label for="username">Username or Email</label>
        <input type="text" name="username" id="username" placeholder="you@domain.com" required />
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" name="pass" id="password" placeholder="••••••••" required />
        <button type="button" class="toggle-pass" id="togglePassword">show</button>
      </div>

      <div class="row">
        <label><input type="checkbox" id="rememberMe" /> Remember me</label>
        <a href="/admin/forget">Forgot password?</a>
      </div>

      <button type="submit" id="loginBtn">Sign In</button>
    </form>
  </div>

<script>
  const pass = document.getElementById('password');
  const toggle = document.getElementById('togglePassword');
  toggle.onclick = () => {
    pass.type = pass.type === 'password' ? 'text' : 'password';
    toggle.textContent = pass.type === 'password' ? 'show' : 'hide';
  };

  document.getElementById('loginForm').onsubmit = (e) => {
    const alertBox = document.getElementById('loginAlert');
    if (!document.getElementById('username').value.trim() || !pass.value.trim()) {
      e.preventDefault();
      alertBox.classList.remove('hidden');
    }
  };
</script>
</body>
</html>