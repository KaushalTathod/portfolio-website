<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>ABOUT</h2>
        </div>

        <div class="card">

            <div class="card-body">

                <form action="/admin/about_add_save" method="POST" enctype="multipart/form-data">

                    <!-- Basic Information -->
                    <div class="row g-3 mb-4">

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label">Profession</label>
                            <input type="text"
                                   name="aprofession"
                                   value="<%= about[0].aprofession %>"
                                   class="form-control">
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label">Location</label>
                            <input type="text"
                                   name="alocation"
                                   value="<%= about[0].alocation %>"
                                   class="form-control">
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email"
                                   name="aemail"
                                   value="<%= about[0].aemail %>"
                                   class="form-control">
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label">Name</label>
                            <input type="text"
                                   name="aname"
                                   value="<%= about[0].aname %>"
                                   class="form-control">
                        </div>

                    </div>

                    <!-- Details -->
                    <div class="row g-4">

                        <!-- Left -->
                        <div class="col-lg-5">

                            <div class="mb-3">
                                <label class="form-label">Freelance</label>
                                <input type="text"
                                       name="afreelance"
                                       value="<%= about[0].afreelance %>"
                                       class="form-control">
                            </div>

                            <div>
                                <label class="form-label">Summary</label>
                                <textarea
                                    name="asummary"
                                    rows="12"
                                    class="form-control"><%= about[0].asummary %></textarea>
                            </div>

                        </div>

                        <!-- Center -->
                        <div class="col-lg-4">

                            <div class="mb-3">
                                <label class="form-label">Experience</label>
                                <input type="number"
                                       name="aexperience"
                                       value="<%= about[0].aexperience %>"
                                       class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Completed Projects</label>
                                <input type="number"
                                       name="aprojectcom"
                                       value="<%= about[0].aprojectcom %>"
                                       class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Happy Clients</label>
                                <input type="number"
                                       name="ahappyclients"
                                       value="<%= about[0].ahappyclients %>"
                                       class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Awards</label>
                                <input type="number"
                                       name="aaward"
                                       value="<%= about[0].aaward %>"
                                       class="form-control">
                            </div>

                            <div>
                                <label class="form-label">Years of Experience</label>
                                <input type="number"
                                       name="ayear"
                                       value="<%= about[0].ayear %>"
                                       class="form-control">
                            </div>

                        </div>

                        <!-- Right -->
                        <div class="col-lg-3">

                            <label class="form-label">Current Image</label>

                            <div class="border rounded text-center p-2 mb-3">
                                <img src="/<%= about[0].aimg %>"
                                     class="img-fluid rounded"
                                     style="max-height:200px;">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Upload Image</label>
                                <input type="file"
                                       name="aimg"
                                       class="form-control">
                            </div>

                            <input type="hidden"
                                   name="old_img"
                                   value="<%= about[0].aimg %>">

                            <button type="submit" class="btn btn-primary w-100">
                                Save Changes
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

<%- include('footer') %>