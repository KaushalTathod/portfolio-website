<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>SKILL</h2>
            <a href="/admin/skill_list" class="header-action-btn" title="View List">+</a>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Add Skill</h5>
            </div>

            <div class="card-body">

                <form action="/admin/skill_add_save" method="POST">

                    <div class="row g-3">

                        <div class="col-lg-6">
                            <label class="form-label">Technical Skill</label>
                            <input type="text" name="tech_name" class="form-control" required>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Percentage</label>
                            <input type="number" name="tech_per" class="form-control" min="0" max="100" required>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Skill
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>