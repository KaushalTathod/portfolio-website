<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Portfolio Admin</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin/style.css" />
    <style>
/* Sub Menu */
.collapse {
    transition: all 0.3s ease;
}

.collapse li {
    list-style: none;
}

.collapse li a {
    display: block;
    padding: 10px 15px 10px 50px;
    color: #ddd;
    text-decoration: none;
    font-size: 15px;
    transition: 0.3s;
}

.collapse li a:hover {
    background: #34495e;
    color: #fff;
    border-radius: 5px;
}

/* Arrow Rotation */
.nav-item a[aria-expanded="true"] .fa-chevron-down {
    transform: rotate(180deg);
}

.fa-chevron-down {
    transition: transform 0.3s ease;
}
</style>
</head>
<body>
    <div class="app-wrapper">
        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar" id="sidebar">
                     
                <nav class="sidebar-nav">
                    <ul>
                        <li class="nav-item active">
                            <a href="/admin/">
                                <i class="fas fa-th-large"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-divider">Content</li>

                        <li class="nav-item">
                            <a href="/admin/hero">
                                <i class="fas fa-landmark"></i>
                                <span>Hero Section</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/about">
                                <i class="fas fa-user"></i>
                                <span>About</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/skill_add">
                                <i class="fas fa-cogs"></i>
                                <span>Skills</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/education_add">
                                <i class="fa-solid fa-graduation-cap"></i>
                                <span>Education</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/experience_add">
                                <i class="fa-solid fa-user-tie"></i>
                                <span>Experience</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/services_add">
                                <i class="fas fa-concierge-bell"></i>
                                <span>Services</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/projects">
                                <i class="fas fa-folder-open"></i>
                                <span>Project</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/blog">
                                <i class="fas fa-blog"></i>
                                <span>Blog</span>
                            </a>
                        </li>

                        <li class="nav-divider">Management</li>

                        <li class="nav-item">
                            <a href="/admin/messages">
                                <i class="fas fa-envelope"></i>
                                <span>Messages</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/change_password">
                                <i class="fas fa-key"></i>
                                <span>Reset Password</span>
                            </a>
                        </li>

                        <li class="nav-divider">System</li>

                        <li class="nav-item">
                            <a href="/admin/settings">
                                <i class="fas fa-cog"></i>
                                <span>Settings</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/admin/logout">
                                <i class="fas fa-sign-out-alt text-danger"></i>
                                <span class="text-danger">Logout</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            

        </aside>
        <!-- ===== MAIN CONTENT ===== -->
        <div class="main-content">
            <!-- ===== NAVBAR ===== -->
            <header class="navbar-top">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light" id="sidebarToggleBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search..." class="form-control form-control-sm" />
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                    <div class="logo">
                        <a href="/" style="margin-right:30px;">
                            <img src="/<%= contact.logo %>" alt="Logo" width="150" height="28">
                        </a>
                    </div>
                </div>
            </header>
