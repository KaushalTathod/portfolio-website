<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>PROJECTS</h2>
            <a href="/admin/projects_list" class="header-action-btn" title="View List">−</a>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Add Project</h5>
            </div>

            <div class="card-body">

                <form action="/admin/projects_add_save" method="POST" enctype="multipart/form-data">

                    <div class="row g-3">

                        <div class="col-lg-6">
                            <label class="form-label">Project Name</label>
                            <input type="text" name="pname" class="form-control" required>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Project Type</label>
                            <input type="text" name="ptype" class="form-control" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Project Image</label>
                            <input type="file" name="pimg" class="form-control" required>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Project
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

