<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>HERO</h2>
        </div>

        <div class="card">

            <div class="card-body">

                <form action="/admin/hero_add_save" method="POST" enctype="multipart/form-data">

                    <!-- Name & Profession -->
                    <div class="row g-3 mb-4">

                        <div class="col-lg-6">
                            <label class="form-label">Name</label>
                            <input
                                type="text"
                                name="hname"
                                value="<%= hero[0].hname %>"
                                class="form-control">
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Profession</label>
                            <input
                                type="text"
                                name="hprofession"
                                value="<%= hero[0].hprofession %>"
                                class="form-control">
                        </div>

                    </div>

                    <!-- About & Image -->
                    <div class="row g-4">

                        <!-- Left -->
                        <div class="col-lg-6">

                            <label class="form-label">About</label>
                            <textarea
                                name="habout"
                                rows="12"
                                class="form-control"><%= hero[0].habout %></textarea>

                        </div>

                        <!-- Right -->
                        <div class="col-lg-6">

                            <label class="form-label">Current Image</label>

                            <div class="border rounded text-center p-2 mb-3">
                                <img
                                    src="/<%= hero[0].himg %>"
                                    class="img-fluid rounded"
                                    style="max-height:180px;">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Upload Image</label>
                                <input
                                    type="file"
                                    name="himg"
                                    class="form-control">
                            </div>

                            <input
                                type="hidden"
                                name="old_img"
                                value="<%= hero[0].himg %>">

                            <button
                                type="submit"
                                class="btn btn-primary w-100">
                                Save Changes
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

<%- include('footer') %>