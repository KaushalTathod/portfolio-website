<%- include('header') %>

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1">Account Settings</h1>
                <p class="text-muted small mb-0">Update your profile and password</p>
            </div>
        </div>
        
        <div class="row g-4 mt-2">
            <div class="col-md-8">
                <% if(typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>
                <% if(typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success"><%= success %></div>
                <% } %>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <form action="/admin/change_password_save" method="post">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted">Old Username</label>
                                    <input type="text" class="form-control bg-light" value="<%= old_username %>" readonly>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">New Username</label>
                                    <input type="text" name="new_username" class="form-control" placeholder="Enter new username">
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted">Old Email</label>
                                    <input type="email" class="form-control bg-light" value="<%= old_email %>" readonly>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">New Email</label>
                                    <input type="email" name="new_email" class="form-control" placeholder="Enter new email">
                                </div>
                            </div>

                            <hr class="my-4">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-danger">Old Password (Required)</label>
                                    <input type="password" name="old_password" class="form-control" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">New Password</label>
                                    <input type="password" name="new_password" class="form-control" minlength="4" placeholder="Enter new password (optional)">
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mt-2">
                                <i class="fas fa-save me-2"></i>Update Account
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<%- include('footer') %>
