<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>SKILL</h2>
            <a href="/admin/skill_list" class="header-action-btn" title="View List">−</a>
        </div>

        <div class="card">

            <div class="card-header">
                <h5 class="mb-0">Update Skill</h5>
            </div>

            <div class="card-body">

                <form action="/admin/update_skill" method="POST">

                    <input type="hidden" name="tid" value="<%= skill.tid %>">

                    <div class="row g-3">

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Technical Skill</label>
                            <input
                                type="text"
                                name="tech_name"
                                value="<%= skill.tech_name %>"
                                class="form-control"
                                placeholder="Enter Technical Skill"
                                required>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Percentage</label>
                            <input
                                type="number"
                                name="tech_per"
                                value="<%= skill.tech_per %>"
                                class="form-control"
                                placeholder="Enter Percentage"
                                min="0"
                                max="100"
                                required>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Update Skill
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

<%- include('footer') %>