<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>BLOG</h2>
            <a href="/admin/blog" class="header-action-btn" title="Add New">+</a>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th width="80">#</th>
                                <th>Date</th>
                                <th>Title</th>
                                <th>Content</th>
                                <th>Image</th>
                                <th width="160" class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if(blog.length > 0){ %>

                                <% for(let i = 0; i < blog.length; i++){ %>
                                    <tr>
                                        <td><%= i + 1 %></td>

                                        <td>
                                            <%= blog[i].bdate %>
                                        </td>

                                        <td>
                                            <strong><%= blog[i].btitle %></strong>
                                        </td>

                                        <td>
                                            <%= blog[i].bcontent %>
                                        </td>

                                        <td>
                                            <img src="/<%= blog[i].bimg %>" width="80" height="60" class="img-thumbnail">
                                        </td>

                                        <td class="text-center">

                                            <a href="/admin/edit_blog/<%= blog[i].bid %>"
                                                class="btn btn-warning btn-sm me-1"
                                                title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a href="/admin/delete_blog/<%= blog[i].bid %>"
                                                class="btn btn-danger btn-sm"
                                                title="Delete"
                                                onclick="return confirm('Are you sure you want to delete this blog?')">
                                                <i class="fas fa-trash"></i>
                                            </a>

                                        </td>
                                    </tr>
                                <% } %>

                            <% } else { %>

                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        No blog found.
                                    </td>
                                </tr>

                            <% } %>
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

