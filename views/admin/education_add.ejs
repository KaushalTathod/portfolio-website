<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>EDUCATION</h2>
            <a href="/admin/education_list" class="header-action-btn" title="View List">−</a>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Add Education</h5>
            </div>

            <div class="card-body">

                <form action="/admin/education_add_save" method="POST">

                    <div class="row g-3">

                        <div class="col-lg-6">
                            <label class="form-label">Education Duration</label>
                            <input type="text" name="eyear" class="form-control" required>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Degree</label>
                            <input type="text" name="edegree" class="form-control" required>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">University</label>
                            <input type="text" name="eunivercity" class="form-control" required>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Education
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

