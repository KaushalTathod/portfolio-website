<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>PROJECTS</h2>
            <a href="/admin/projects_list" class="header-action-btn" title="View List">−</a>
        </div>

        <div class="card">

            <div class="card-header">
                <h5 class="mb-0">Update Project</h5>
            </div>

            <div class="card-body">

                <form action="/admin/project_update_save" method="POST" enctype="multipart/form-data">

                    <input type="hidden" name="pid" value="<%= project.pid %>">

                    <div class="row g-3">

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Project Name</label>
                            <input
                                type="text"
                                name="pname"
                                value="<%= project.pname %>"
                                class="form-control"
                                placeholder="Enter Project Name"
                                required>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Project Type</label>
                            <input
                                type="text"
                                name="ptype"
                                value="<%= project.ptype %>"
                                class="form-control"
                                placeholder="Enter Project Type"
                                required>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Project Image</label>
                            <input type="file" name="pimg" class="form-control">
                            <input type="hidden" name="old_img" value="<%= project.pimg %>">
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label class="form-label">Current Image</label>
                            <div>
                                <img src="/<%= project.pimg %>" width="150" class="img-thumbnail">
                            </div>
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Update Project
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

<%- include('footer') %>

