<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>EDUCATION</h2>
            <a href="/admin/education_add" class="header-action-btn" title="Add New">+</a>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th width="80">#</th>
                                <th>Education Duration</th>
                                <th width="180">Degree</th>
                                <th width="180">University</th>
                                <th width="160" class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if(education.length > 0){ %>

                                <% for(let i = 0; i < education.length; i++){ %>
                                    <tr>
                                        <td><%= i + 1 %></td>

                                        <td>
                                            <strong><%= education[i].eyear %></strong>
                                        </td>

                                        <td>
                                            <%= education[i].edegree %>
                                        </td>

                                        <td>
                                            <%= education[i].eunivercity %>
                                        </td>

                                        <td class="text-center">

                                            <a href="/admin/edit_education/<%= education[i].eid %>"
                                                class="btn btn-warning btn-sm me-1"
                                                title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a href="/admin/delete_education/<%= education[i].eid %>"
                                                class="btn btn-danger btn-sm"
                                                title="Delete"
                                                onclick="return confirm('Are you sure you want to delete this education?')">
                                                <i class="fas fa-trash"></i>
                                            </a>

                                        </td>
                                    </tr>
                                <% } %>

                            <% } else { %>

                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        No education found.
                                    </td>
                                </tr>

                            <% } %>
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

