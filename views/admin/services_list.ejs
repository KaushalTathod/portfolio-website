<%- include('header') %>

<div class="page-content">
    <div class="container-fluid px-4">

        <!-- Page Header -->
        <div class="page-header-bar">
            <h2>SERVICES</h2>
            <a href="/admin/services_add" class="header-action-btn" title="Add New">+</a>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th width="80">#</th>
                                <th>Service Technology</th>
                                <th>Description</th>
                                <th width="160" class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if(services.length > 0){ %>

                                <% for(let i = 0; i < services.length; i++){ %>
                                    <tr>
                                        <td><%= i + 1 %></td>

                                        <td>
                                            <strong><%= services[i].ser_technology %></strong>
                                        </td>

                                        <td>
                                            <%= services[i].ser_discription %>
                                        </td>

                                        <td class="text-center">

                                            <a href="/admin/edit_service/<%= services[i].sid %>"
                                                class="btn btn-warning btn-sm me-1"
                                                title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a href="/admin/delete_service/<%= services[i].sid %>"
                                                class="btn btn-danger btn-sm"
                                                title="Delete"
                                                onclick="return confirm('Are you sure you want to delete this service?')">
                                                <i class="fas fa-trash"></i>
                                            </a>

                                        </td>
                                    </tr>
                                <% } %>

                            <% } else { %>

                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        No services found.
                                    </td>
                                </tr>

                            <% } %>
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

<%- include('footer') %>

