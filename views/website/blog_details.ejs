<%- include('header') %>

<!-- ===== BLOG DETAILS SECTION ===== -->
<section class="blog">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <article class="blog-detail-card">

                    <!-- Meta info -->
                    <div class="blog-detail-meta">
                        <span class="blog-detail-date">
                            <i class="far fa-calendar-alt"></i>
                            <%= new Date(blog.bdate).toLocaleDateString('en-US', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                        </span>
                    </div>

                    <!-- Title -->
                    <h1 class="blog-detail-title"><%= blog.btitle %></h1>

                    <!-- Divider -->
                    <div class="blog-detail-divider"></div>

                    <!-- Content -->
                    <div class="blog-detail-content">
                        <%= blog.bcontent %>
                    </div>

                    <!-- Back button -->
                    <button
                        class="btn btn-primary mt-4"
                        onclick="window.location.href='/blog'">
                        ← Back to Blogs
                    </button>

                </article>

            </div>
        </div>

    </div>
</section>

<%- include('footer') %>